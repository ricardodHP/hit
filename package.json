{
  "name": "ruins-of-asteria",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint eslint.config.js && tsc --noEmit",
    "assets:generate": "node scripts/generateRasterAssets.mjs",
    "postinstall": "npm run assets:generate",
    "predev": "npm run assets:generate",
    "prebuild": "npm run assets:generate",
    "pretest": "npm run assets:generate"
  },
  "dependencies": {
    "@vitejs/plugin-basic-ssl": "latest",
    "phaser": "^3.90.0",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.31.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vitest": "^3.2.4"
  }
}
